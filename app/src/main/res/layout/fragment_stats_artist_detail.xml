<?xml version="1.0" encoding="utf-8"?>
<!-- Artist detail stats screen (see CLAUDE.md, Component 4; redesigned in Component 6's
     pivot away from charts). No time-window button, no time-series chart, no by-album pie
     chart anymore an Overview block plus two ranked text lists (Top Albums, Top Songs),
     each populated at runtime via StatsRowBinder. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextAppearance="@style/ToolbarTextAppearanceNormal" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="@integer/overScrollMode"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_overview"
                android:textAppearance="@style/TextViewSubtitle1"
                android:textStyle="bold" />

            <!-- Populated at runtime: Total Playtime, Discography length, Albums, Songs
                 see StatsArtistDetailFragment.renderOverview. -->
            <LinearLayout
                android:id="@+id/overviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/stats_top_albums"
                android:textAppearance="@style/TextViewSubtitle1"
                android:textStyle="bold" />

            <!-- Every album by this artist, ranked descending by mock playtime uncapped. -->
            <LinearLayout
                android:id="@+id/topAlbumsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/stats_top_songs"
                android:textAppearance="@style/TextViewSubtitle1"
                android:textStyle="bold" />

            <!-- This artist's songs, ranked descending by mock playtime, capped at 15. -->
            <LinearLayout
                android:id="@+id/topSongsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
